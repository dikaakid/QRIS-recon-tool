# QRIS Recon Tool - configuration
# Copy this file to `.env` and adjust. Every variable is optional.

# --- Folder paths ---
RECON_MUTASI_DIR=./data/mutasi
RECON_DASH_DIR=./data/dash
RECON_GDS_DIR=./data/gds
RECON_OUTPUT_DIR=./output

# --- Output file name prefixes (cosmetic) ---
RECON_OUTPUT_PREFIX=Recon
RECON_PARQUET_PREFIX=LinePerLine_Full

# --- Rows of the bank statement that are not QRIS settlements (comma-separated) ---
RECON_NON_RECON_KEYWORDS=INTERNAL TRANSFER
RECON_NON_RECON_PREFIXES=AC-,Sharing MDR

# --- Acquirer tag ---
# Tag at the end of midnight-boundary batch references, e.g. BA-YYMMDD0000-<TAG>.
# If unset, midnight-boundary detection for double settlement is disabled (a warning is printed).
# The synthetic sample data uses SAMPLEACQ.
RECON_ACQUIRER_TAG=