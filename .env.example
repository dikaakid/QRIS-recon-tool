# QRIS Recon Tool - configuration
# Copy this file to `.env` and adjust to your local setup.
# All variables are optional; the script has sensible defaults.

# --- Folder paths ---
RECON_MUTASI_DIR=./data/mutasi
RECON_DASH_DIR=./data/dash
RECON_GDS_DIR=./data/gds
RECON_OUTPUT_DIR=./output

# --- Output file name prefixes (cosmetic) ---
RECON_OUTPUT_PREFIX=Recon
RECON_PARQUET_PREFIX=LinePerLine_Full

# --- Acquirer tag ---
# Used to detect midnight-boundary batch references in the double-settlement check.
# Set this to the acquirer tag that appears at the end of batch references.
# Example: if a batch ref looks like "BA-YYMMDD0000-<TAG>", set RECON_ACQUIRER_TAG=<TAG>.
# If unset, midnight-boundary detection is disabled (the script prints a warning).
RECON_ACQUIRER_TAG=